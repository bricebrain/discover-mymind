{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "variantKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
    },
    "keyVocab": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "speaker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "fr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "startMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "endMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceSegments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,64}$"
            }
          },
          "provenance": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^d[1-6]$"
              },
              "segmentId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "startMs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "endMs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            },
            "required": [
              "sourceId",
              "segmentId",
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "text",
          "startMs",
          "endMs"
        ],
        "additionalProperties": false
      }
    },
    "guide": {
      "type": "object",
      "description": "Original guidé : passage de travail, expressions et points d'écoute, rédigés au niveau CECRL de l'apprenant.",
      "properties": {
        "level": {
          "enum": [
            "A2",
            "B1",
            "B2",
            "C1"
          ]
        },
        "voice": {
          "enum": [
            "original",
            "synthetic"
          ]
        },
        "passage": {
          "type": "object",
          "properties": {
            "fromSegment": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,64}$"
            },
            "toSegment": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "fromSegment",
            "toSegment"
          ],
          "additionalProperties": false
        },
        "expressions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "segmentId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            },
            "required": [
              "segmentId",
              "text",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "listening": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "segmentId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            },
            "required": [
              "segmentId",
              "text",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "dictation": {
          "type": "array",
          "description": "Dictée phrase par phrase : unités de 3 à 25 mots du passage, horodatées, dans l'ordre, chacune contenue dans le texte de son segment.",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "segmentId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "segmentId",
              "text",
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "level",
        "voice",
        "passage",
        "expressions",
        "listening"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "variantKey",
    "segments"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://discover.local/segments.schema.json"
}
